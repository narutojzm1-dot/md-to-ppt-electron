{
  "name": "md-to-ppt",
  "version": "1.0.0",
  "description": "Markdown 一键转 Marp PPT 桌面应用",
  "main": "dist-electron/electron/main.js",
  "author": "MD to PPT",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "test:web": "node scripts/ui-smoke-test.mjs",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.md2ppt.app",
    "productName": "MD to PPT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@marp-team/marp-cli/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    },
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.60.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "@marp-team/marp-cli": "^4.4.1",
    "@marp-team/marp-core": "^4.3.1",
    "openai": "^6.33.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
